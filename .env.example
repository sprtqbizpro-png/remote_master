# ---- Supabase (Postgres) ----
# Supabase dashboard > Connect > ORMs > Prisma. Replace [PROJECT-REF], [PASSWORD] and [REGION].
# Runtime connection for a long-running server: the SESSION-mode pooler (port 5432). Prisma over the
# transaction pooler (6543, pgbouncer=true) needs several round trips per query (measured ~5x slower).
# Keep connection_limit below the project's pool size (Database > Settings; 15 on the smallest plan).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?connection_limit=10"
# Serverless hosting (Vercel, Netlify, ...) instead: the transaction pooler, one connection per instance:
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct/session connection (port 5432) used by `prisma migrate`:
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Long random string used to sign session cookies and extension tokens.
AUTH_SECRET="change-me-to-a-long-random-string"

# First platform owner, created by `npm run db:seed`.
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="ChangeMe123!"
SEED_OWNER_NAME="Platform Owner"

# Public URL of this platform (used for links to locally stored resumes).
APP_URL="http://localhost:3000"

# ---- Google (Sheets + Drive) ----
# Option A (recommended, works with personal Gmail): OAuth client + refresh token.
#   Create an OAuth "Desktop app" client in Google Cloud, enable Sheets API + Drive API,
#   then run `npm run google:auth` to obtain the refresh token.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
# Option B: service account key JSON (raw JSON or base64). Share the sheet and a
#   Shared Drive folder with the service account email. (Service accounts have no
#   My Drive quota, so resumes must go to a Shared Drive folder.)
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Defaults; both can also be set from Admin > Settings in the UI.
GOOGLE_SHEET_ID=""
GOOGLE_DRIVE_FOLDER_ID=""
# "true" makes uploaded resumes viewable by anyone with the link.
GOOGLE_DRIVE_SHARE_PUBLIC="false"

# ---- Answer autofill (OpenAI) ----
# The extension's "Autofill answers" writes answers to an application form's open-ended questions
# from the attached resume and the job description. Server-side only: never put the key in the extension.
OPENAI_API_KEY=""
# Optional; can also be set under Admin > Settings. Default: gpt-4.1-mini.
OPENAI_MODEL=""
# Optional: an OpenAI-compatible endpoint (proxy, Azure OpenAI, ...). Default: https://api.openai.com/v1
OPENAI_BASE_URL=""
